<section class="ddb-muncher-main">

  
  <!-- Master Full Munch Hero Card -->
  <fieldset class="jenne-munch-hero-fieldset">
    <legend><i class="fas fa-file-import"></i> Complete Compendium Import</legend>
    <div class="jenne-munch-hero-content" style="display: flex; flex-direction: column; gap: 10px; align-items: stretch; text-align: center;">
      <div>
        <h4 style="margin: 0 0 4px 0; color: var(--jenne-text-active); font-size: 13.5px; font-family: 'Cinzel', Georgia, serif; font-weight: 700;">One-Click Full Library Build</h4>
        <p class="hint" style="margin: 0; font-size: 11.5px; line-height: 1.45;">Extracts and builds all Spells, Items, Monsters, Vehicles, and Frames automatically in the correct dependency order.</p>
      </div>
      <button data-action="parseAllMunchers" type="button" class="munch-button jenne-btn-hero" style="width: 100% !important; height: 36px !important; font-size: 13px !important; margin: 4px 0 0 0 !important;">
        <i class="fas fa-file-import"></i> Import Everything
      </button>
    </div>
  </fieldset>


  <!-- Core Content Munchers List -->
  <fieldset style="margin-top: 14px;">
    <legend><i class="fas fa-database"></i> Compendium Content Importers</legend>
    <div class="jenne-munch-list" style="display: flex; flex-direction: column; gap: 8px; margin-top: 8px;">

      <!-- Characters -->
      <div class="jenne-munch-row">
        <div class="jenne-munch-row-left">
          <i class="fas fa-users jenne-munch-card-icon"></i>
          <div class="jenne-munch-row-info">
            <div class="jenne-munch-row-title-bar">
              <span class="jenne-munch-card-title">Characters</span>
              <span class="hint">Player Characters &amp; Companions</span>
            </div>
            <p class="hint jenne-munch-desc" style="margin: 2px 0 0 0 !important;">Import player characters and companions from your linked D&amp;D Beyond campaign into Foundry VTT.</p>
          </div>
        </div>
        <button data-action="openCharacters" type="button" id="munch-characters-start" class="munch-button jenne-munch-action-btn" style="width: 170px !important; flex-shrink: 0;">
          <i class="fas fa-users"></i> Import Characters
        </button>
      </div>
      
      <!-- Spells -->
      <div class="jenne-munch-row">
        <div class="jenne-munch-row-left">
          <i class="fas fa-magic jenne-munch-card-icon"></i>
          <div class="jenne-munch-row-info">
            <div class="jenne-munch-row-title-bar">
              <span class="jenne-munch-card-title">Spells</span>
              <span class="hint">Cantrips & Level 1–9 Spells</span>
            </div>
            <p class="hint jenne-munch-desc" style="margin: 2px 0 0 0 !important;">Extracts complete spellbooks, saving throws, damage formulas, and scaling rules.</p>
          </div>
        </div>
        <button data-action="parseSpells" type="button" id="munch-spells-start" class="munch-button jenne-munch-action-btn" style="width: 170px !important; flex-shrink: 0;">
          <i class="fas fa-magic"></i> Import Spells
        </button>
      </div>

      <!-- Items & Equipment -->
      <div class="jenne-munch-row">
        <div class="jenne-munch-row-left">
          <i class="fas fa-shield-alt jenne-munch-card-icon"></i>
          <div class="jenne-munch-row-info">
            <div class="jenne-munch-row-title-bar">
              <span class="jenne-munch-card-title">Items & Equipment</span>
              <span class="hint">Weapons, Armor, Magic Items</span>
            </div>
            <p class="hint jenne-munch-desc" style="margin: 2px 0 0 0 !important;">Extracts equipment with 2024 masteries, magical properties, and linked spell scrolls (auto-imports spells if needed).</p>
          </div>
        </div>
        <button data-action="parseItemsWithDependencies" type="button" id="munch-items-start" class="munch-button jenne-munch-action-btn" style="width: 170px !important; flex-shrink: 0;">
          <i class="fas fa-boxes"></i> Import Items
        </button>
      </div>

      <!-- Monsters -->
      <div class="jenne-munch-row">
        <div class="jenne-munch-row-left">
          <i class="fas fa-skull jenne-munch-card-icon"></i>
          <div class="jenne-munch-row-info">
            <div class="jenne-munch-row-title-bar">
              <span class="jenne-munch-card-title">Monsters & NPCs</span>
              <span class="hint">Statblocks, Tokens & Actions</span>
            </div>
            <p class="hint jenne-munch-desc" style="margin: 2px 0 0 0 !important;">Extracts monster statblocks, actions, token art, legendary actions, and senses (auto-imports spells & items if needed).</p>
          </div>
        </div>
        <button data-action="parseMonstersWithDependencies" type="button" id="munch-monsters-start" class="munch-button jenne-munch-action-btn" style="width: 170px !important; flex-shrink: 0;">
          <i class="fas fa-skull"></i> Import Monsters
        </button>
      </div>

      <!-- Vehicles -->
      <div class="jenne-munch-row">
        <div class="jenne-munch-row-left">
          <i class="fas fa-ship jenne-munch-card-icon"></i>
          <div class="jenne-munch-row-info">
            <div class="jenne-munch-row-title-bar">
              <span class="jenne-munch-card-title">Vehicles</span>
              <span class="hint">Land, Sea & Spelljammers</span>
            </div>
            <p class="hint jenne-munch-desc" style="margin: 2px 0 0 0 !important;">Extracts siege weapons, ship stats, speed, creature capacities, and hull components.</p>
          </div>
        </div>
        <button data-action="parseVehicles" type="button" id="munch-vehicles-start" class="munch-button jenne-munch-action-btn" style="width: 170px !important; flex-shrink: 0;">
          <i class="fas fa-ship"></i> Import Vehicles
        </button>
      </div>

      <!-- Token Frames -->
      <div class="jenne-munch-row">
        <div class="jenne-munch-row-left">
          <i class="fas fa-circle-notch jenne-munch-card-icon"></i>
          <div class="jenne-munch-row-info">
            <div class="jenne-munch-row-title-bar">
              <span class="jenne-munch-card-title">Token Frames</span>
              <span class="hint">D&D Beyond Ring Borders</span>
            </div>
            <p class="hint jenne-munch-desc" style="margin: 2px 0 0 0 !important;">Downloads decorative token ring frames from your unlocked D&D Beyond library.</p>
          </div>
        </div>
        <button data-action="parseFrames" type="button" id="munch-frames-start" class="munch-button jenne-munch-action-btn" style="width: 170px !important; flex-shrink: 0;">
          <i class="fas fa-circle-notch"></i> Import Frames
        </button>
      </div>

      <!-- Adventures & Sourcebooks -->
      <div class="jenne-munch-row">
        <div class="jenne-munch-row-left">
          <i class="fas fa-dungeon jenne-munch-card-icon"></i>
          <div class="jenne-munch-row-info">
            <div class="jenne-munch-row-title-bar">
              <span class="jenne-munch-card-title">Adventures &amp; Sourcebooks</span>
              <span class="hint">Campaigns, Scenes &amp; Journals</span>
            </div>
            <p class="hint jenne-munch-desc" style="margin: 2px 0 0 0 !important;">Import complete adventure modules, maps, dynamic walls, lighting, and journals from selected sources directly into compendiums.</p>
          </div>
        </div>
        <button data-action="parseAdventures" type="button" id="munch-adventures-start" class="munch-button jenne-munch-action-btn" style="width: 170px !important; flex-shrink: 0;">
          <i class="fas fa-dungeon"></i> Import Adventures
        </button>
      </div>

    </div>
  </fieldset>


</section>
