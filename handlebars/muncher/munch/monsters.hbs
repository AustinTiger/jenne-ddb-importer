<section id="ddb-importer-muncher-monsters" class="tab ddb-muncher {{ tab.cssClass }} {{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  
  <fieldset>
    <legend><i class="fas fa-dragon"></i> Monster Muncher</legend>
    <p class="hint">Downloads and builds monster statblocks, tokens, artwork, and action activities from your selected sourcebooks into your target DDB Monsters compendium using your global Munch Settings.</p>
    
    <div style="margin-top: 14px;">
      <button data-action="parseMonsters" type="button" id="munch-monsters-start" class="munch-button" style="width: 100%; height: 38px; font-size: 13px;">
        <i class="fas fa-skull"></i> Monster Munch!
      </button>
    </div>
  </fieldset>

</section>
