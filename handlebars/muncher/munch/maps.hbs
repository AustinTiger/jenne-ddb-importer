<section id="ddb-importer-muncher-maps" class="tab ddb-muncher {{ tab.cssClass }} {{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  <fieldset>
    <legend><i class="fas fa-map"></i> D&D Beyond Maps & Stickers</legend>
    <p class="hint">Import maps and stickers directly from your D&D Beyond Maps campaigns with automatic scene detection, lighting, walls, and grid alignment.</p>
  </fieldset>

  <div style="display: flex; gap: 10px; margin-top: 14px;">
    <button data-action="openMapBrowser" type="button" id="munch-maps-open" class="munch-button" style="flex: 1; height: 38px;">
      <i class="fas fa-map"></i> Open Map Browser
    </button>
    <button data-action="openStickerBrowser" type="button" id="munch-stickers-open" class="munch-button" style="flex: 1; height: 38px;">
      <i class="fas fa-shapes"></i> Open Sticker Browser
    </button>
  </div>
</section>
