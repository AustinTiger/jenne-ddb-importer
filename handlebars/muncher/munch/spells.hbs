<section id="ddb-importer-muncher-spells" class="tab ddb-muncher {{ tab.cssClass }} {{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  
  <fieldset>
    <legend><i class="fas fa-magic"></i> Spell Muncher</legend>
    <p class="hint">Downloads and builds spells from your selected sourcebooks into your target DDB Spells compendium using your global Munch Settings.</p>
    
    <div style="margin-top: 14px;">
      <button data-action="parseSpells" type="button" id="munch-spells-start" class="munch-button" style="width: 100%; height: 38px; font-size: 13px;">
        <i class="fas fa-magic"></i> Spell Munch!
      </button>
    </div>
  </fieldset>

</section>
