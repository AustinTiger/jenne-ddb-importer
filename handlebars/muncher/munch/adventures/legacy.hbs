<section id="ddb-importer-muncher-adventures-legacy" class="tab ddb-muncher {{ tab.cssClass }} {{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  <fieldset>
  <legend>Information</legend>

      <div>
          <p>Adventure Munching allows importing pre-generated .fvttadv adventure archives directly into Foundry VTT.</p>
      </div>
    <div>
      <i>When you import an adventure it will use the items, spells and monsters in your DDB compendiums. If it can't find them it will attempt to import from DDB, and will use the currently selected settings in the muncher!</i>
    </div>

  </fieldset>

  <button data-action="generateAdventureConfig" type="button" id="munch-adventure-config-start" class="munch-button"><i class="fas fa-cog"></i> Generate Adventure Muncher Config File</button>

  <fieldset>
  <legend>Options</legend>
    {{#each adventureOptions}}
    <div class="form-group adventure-config">
      <label>{{ this.label }}</label>
      <div class="form-fields">
        <dnd5e-checkbox name="{{this.name}}" id="{{this.name}}" {{#if this.isChecked}}checked{{/if}}
        data-section="{{this.name}}" {{#if this.enabled}}enabled{{else}}disabled{{/if}}></dnd5e-checkbox>
      </div>
      <p class="hint">{{{this.hint}}}</p>
    </div>
  {{/each}}
  </fieldset>

  <fieldset>
  <legend>Adventure File</legend>
    <p>Select an adventure file to upload and import.</p>
    <div>
      <div class="form-group">
        <input id="munch-adventure-file" type="file" name="data" accept=".fvttadv"/>
      </div>
    </div>
  </fieldset>

  <button data-action="importAdventure" type="button" id="munch-adventure-import-start" class="munch-button"><i class="fas fa-check"></i> Import Generated Adventure</button>
  <button data-action="importThirdParty" type="button" id="munch-adventure-third-party-start" class="munch-button"><i class="fas fa-map-marked-alt"></i> Enhance Third Party Scenes</button>
</section>
