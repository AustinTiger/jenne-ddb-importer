<section id="ddb-importer-muncher-token-frames" class="tab ddb-muncher {{ tab.cssClass }} {{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  
  <fieldset>
    <legend><i class="fas fa-circle-notch"></i> Token Frames</legend>
    <p class="hint">Downloads official character and creature token frames and borders from D&D Beyond into your local token storage.</p>
    
    <div style="margin-top: 14px;">
      <button data-action="parseFrames" type="button" id="munch-frames-start" class="munch-button" style="width: 100%; height: 38px; font-size: 13px;">
        <i class="fas fa-circle-notch"></i> Token Frame Munch!
      </button>
    </div>
  </fieldset>

</section>
