<section id="ddb-importer-muncher-vehicles" class="tab ddb-muncher {{ tab.cssClass }} {{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  
  <fieldset>
    <legend><i class="fas fa-ship"></i> Vehicle Muncher</legend>
    <p class="hint">Downloads and builds vehicle statblocks, actions, and features from your selected sourcebooks into your target DDB Vehicles compendium.</p>
    
    <div style="margin-top: 14px;">
      <button data-action="parseVehicles" type="button" id="munch-vehicles-start" class="munch-button" style="width: 100%; height: 38px; font-size: 13px;">
        <i class="fas fa-anchor"></i> Vehicle Munch!
      </button>
    </div>
  </fieldset>

</section>
