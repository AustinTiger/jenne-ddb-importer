<section id="ddb-importer-muncher-items" class="tab ddb-muncher {{ tab.cssClass }} {{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  
  <fieldset>
    <legend><i class="fas fa-shield-alt"></i> Item & Equipment Muncher</legend>
    <p class="hint">Downloads and builds equipment, weapons, armor, and magic items from your selected sourcebooks into your target DDB Items compendium using your global Munch Settings.</p>
    
    <div style="margin-top: 14px;">
      <button data-action="parseItems" type="button" id="munch-items-start" class="munch-button" style="width: 100%; height: 38px; font-size: 13px;">
        <i class="fas fa-boxes"></i> Item Munch!
      </button>
    </div>
  </fieldset>

</section>
