<section id="ddb-importer-muncher-enhancements" class="tab ddb-muncher {{ tab.cssClass }} {{#if tab.active}} active{{/if}}" data-tab="{{ tab.id }}" data-group="{{ tab.group }}">
  
  <fieldset>
    <legend><i class="fas fa-hammer"></i> Weapon Property & Mastery Enhancements</legend>
    <p class="hint">DDB Importer attaches modern weapon properties and masteries (2024 rules) to base weapons. Select the sourcebooks to enable for mastery parsing:</p>

    <div id="weapon-properties-enhancements-source-div" style="margin-top: 8px;">
      <multi-select id="allowed-weapon-property-sources" name="allowed-weapon-property-sources">
        {{#each selectedWeaponPropertiesEnhancementsSources}}
        <option value="{{this.id}}" {{this.selected}}> {{this.label}}</option>
        {{/each}}
      </multi-select>
    </div>
  </fieldset>

  <fieldset style="margin-top: 14px;">
    <legend><i class="fas fa-magic"></i> Gameplay Rule Automations</legend>
    <p class="hint">These provide optional, non-intrusive automation for complex class features (e.g. Arcane Ward HP tracking, Warding Bond damage splitting, Moon Druid wildshape enhancements).</p>
    
    {{#each enhancementConfig}}
    <div class="form-group enhancements-config" style="margin-top: 8px;">
      <label>{{ this.label }}</label>
      <div class="form-fields">
        <dnd5e-checkbox name="{{this.name}}" id="enhancements-config-{{this.name}}" {{#if this.isChecked}}checked{{/if}}
        data-section="{{this.name}}" {{#if this.enabled}}enabled{{else}}disabled{{/if}}></dnd5e-checkbox>
      </div>
      <p class="hint">{{{this.hint}}}</p>
    </div>
    {{/each}}
  </fieldset>

</section>
