<section id="ddb-importer-muncher-general" class="tab ddb-muncher {{ tab.cssClass }} {{#if tab.active}} active{{/if}}" data-tab="{{ tab.id }}" data-group="{{ tab.group }}">
  
  <!-- D&D Beyond Authentication & Proxy -->
  <fieldset>
    <legend><i class="fas fa-key"></i> D&D Beyond Authentication & Proxy</legend>
    
    <div class="form-group">
      <label>Cobalt Session Cookie</label>
      <div class="form-fields" style="display: flex; gap: 8px;">
        <input class="setup-config" type="password" id="cobalt-cookie-input" name="cobalt-cookie" value="{{cobalt}}" placeholder="Auto-managed via Jenne Proxy or paste manually" style="flex: 1;" />
        <button type="button" data-action="checkCobaltButton" id="check-cobalt-button" class="munch-button jenne-form-inline-btn" style="height: 30px !important; padding: 0 10px !important; font-family: 'Inter', sans-serif !important; font-size: 12px !important; font-weight: 500 !important; text-transform: none !important; letter-spacing: normal !important; white-space: nowrap;">
          <i class="fas fa-plug" style="font-size: 11px;"></i> Check Connection
        </button>
      </div>
      <p class="hint">Your D&D Beyond session authentication token. If your Jenne Proxy has auto-login configured, this is managed automatically.</p>
    </div>

    <div class="form-group" style="margin-top: 10px;">
      <label>Custom Proxy URL</label>
      <div class="form-fields">
        <input class="setup-config" type="text" id="custom-proxy-url-input" name="api-endpoint" value="{{customProxyUrl}}" placeholder="https://ddb-proxy.clemson.engineer" />
      </div>
      <p class="hint">The base URL of your self-hosted Jenne DDB Proxy (e.g. <code>https://ddb-proxy.clemson.engineer</code>).</p>
    </div>
  </fieldset>

  <!-- D&D Beyond Campaign -->
  <fieldset style="margin-top: 14px;">
    <legend><i class="fas fa-users"></i> D&D Beyond Campaign</legend>
    <p class="hint">Link your D&D Beyond Campaign to enable campaign content sharing, character imports, and party synchronization.</p>

    <div class="form-group" style="margin-top: 8px;">
      <label>Campaign</label>
      <div class="form-fields" style="display: flex; gap: 8px;">
        <select name="campaign-select" id="settings-campaign-select" class="form-select" style="flex: 1;">
          <option value="">-- Select Linked Campaign --</option>
          {{#each availableCampaigns}}
          <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.name}}{{#if this.dmUsername}} ({{this.dmUsername}}){{/if}} - ID: {{this.id}}</option>
          {{/each}}
        </select>
        <button type="button" id="btn-fetch-campaigns-settings" class="munch-button jenne-form-inline-btn" style="height: 30px !important; padding: 0 10px !important; font-family: 'Inter', sans-serif !important; font-size: 12px !important; font-weight: 500 !important; text-transform: none !important; letter-spacing: normal !important; white-space: nowrap;">
          <i class="fas fa-sync" style="font-size: 11px;"></i> Fetch Campaigns
        </button>
      </div>
    </div>

    <div class="form-group" style="margin-top: 8px;">
      <label>Manual Campaign ID</label>
      <div class="form-fields">
        <input type="text" id="settings-campaign-id-input" name="campaign-id" value="{{campaignId}}" placeholder="e.g. 361284" />
      </div>
      <p class="hint">The numeric ID from your D&D Beyond campaign URL (e.g. <code>https://www.dndbeyond.com/campaigns/361284</code>).</p>
    </div>
  </fieldset>

  <!-- Character Synchronization -->
  <fieldset style="margin-top: 14px;">
    <legend><i class="fas fa-sync"></i> Character Synchronization</legend>
    <p class="hint">Configure real-time two-way synchronization and export policies for characters.</p>

    <div class="form-group" style="margin-top: 8px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap;">
      <label style="white-space: nowrap; flex: 1 0 auto; max-width: none;">Dynamic Character Sync (Currency &amp; Equipment)</label>
      <div class="form-fields" style="flex: 0 0 auto;">
        <dnd5e-checkbox name="dynamic-sync" id="dynamic-sync-checkbox" {{#if dynamicSync}}checked{{/if}} data-section="dynamicSync"></dnd5e-checkbox>
      </div>
      <p class="hint" style="flex: 100%; margin-top: 4px;">Enable real-time synchronization of currency and equipment changes made on Foundry VTT character sheets back to D&amp;D Beyond.</p>
    </div>

    <div class="form-group" style="margin-top: 10px;">
      <label>Which attributes should be exported?</label>
      <div class="form-fields" style="display: flex; gap: 24px; align-items: center; justify-content: flex-end;">
        {{#each syncConfig}}
        <label class="checkbox" style="display: flex; align-items: center; gap: 6px; font-size: 12px; margin: 0; cursor: pointer;">
          <dnd5e-checkbox name="{{this.name}}" id="setting-{{this.name}}" class="ddb-export-policy-checkbox"
            data-section="{{this.name}}" {{#if this.isChecked}}checked{{/if}}
            {{#if this.enabled}}enabled{{else}}disabled{{/if}}></dnd5e-checkbox>
          <span>{{this.label}}</span>
        </label>
        {{/each}}
      </div>
      <p class="hint">Choose which character attributes are pushed to D&amp;D Beyond during manual or party exports.</p>
    </div>

    <div class="form-group" style="margin-top: 10px;">
      <label>Remove equipment not in actor inventory?</label>
      <div class="form-fields">
        <dnd5e-checkbox name="sync-policy-equipment-remove" id="setting-sync-policy-equipment-remove" class="ddb-export-policy-checkbox" {{#if removeEquipmentNotInInventory}}checked{{/if}} data-section="sync-policy-equipment-remove" enabled></dnd5e-checkbox>
      </div>
      <p class="hint">If checked, Export Equipment will add and remove equipment on D&amp;D Beyond. If not checked, it will only add equipment that is missing.</p>
    </div>
  </fieldset>

  <!-- Shared Settings -->
  <fieldset style="margin-top: 14px;">
    <legend><i class="fas fa-sliders-h"></i> Shared Settings</legend>
    {{#each genericConfig}}
    <div class="form-group munching-generic-config">
      <label>{{ this.label }}</label>
      <div class="form-fields">
        <dnd5e-checkbox name="{{this.name}}" id="munching-generic-policy-{{this.name}}" {{#if this.isChecked}}checked{{/if}}
        data-section="{{this.name}}" {{#if this.enabled}}enabled{{else}}disabled{{/if}}></dnd5e-checkbox>
      </div>
      <p class="hint">{{{this.hint}}}</p>
    </div>
    {{/each}}
  </fieldset>

  <!-- Adventure & Sourcebook Import Settings -->
  <fieldset style="margin-top: 14px;">
    <legend><i class="fas fa-book-reader"></i> Adventure & Sourcebook Import Settings</legend>
    <p class="hint">Adventures and sourcebooks are always imported directly to compendium packs with 2024 monsters enabled.</p>
    
    <div class="form-group adventure-config" style="margin-top: 8px;">
      <label>Journals/tables observable by all players?</label>
      <div class="form-fields">
        <dnd5e-checkbox name="adventure-policy-observe-all" id="adventure-config-observe-all" {{#if adventureObserveAll}}checked{{/if}}
        data-section="adventure-policy-observe-all" enabled></dnd5e-checkbox>
      </div>
      <p class="hint">Grant Observer permission to all players for imported adventure journals and rollable tables in the compendiums.</p>
    </div>
  </fieldset>

  <!-- Monster Configuration -->
  <fieldset style="margin-top: 14px;">
    <legend><i class="fas fa-dragon"></i> Monster Configuration</legend>
    
    <div class="form-group" style="margin-top: 8px;">
      <label>Hide monster actions in chat?</label>
      <div class="form-fields">
        <dnd5e-checkbox name="munching-policy-hide-description" id="munching-policy-hide-description" {{#if hideMonsterDescription}}checked{{/if}} data-section="hideDescription"></dnd5e-checkbox>
      </div>
      <p class="hint">Hides monster action details and descriptions from players in chat roll cards.</p>
    </div>

    <div class="form-group" style="margin-top: 10px;">
      <label>Retain existing biographies?</label>
      <div class="form-fields">
        <dnd5e-checkbox name="munching-policy-monster-retain-biography" id="munching-policy-monster-retain-biography" {{#if retainMonsterBiography}}checked{{/if}} data-section="retainBiography"></dnd5e-checkbox>
      </div>
      <p class="hint">Preserve custom GM biography edits when updating existing monsters from compendiums.</p>
    </div>

    <div class="form-group" style="margin-top: 10px;">
      <label>Use full portrait art for tokens?</label>
      <div class="form-fields">
        <dnd5e-checkbox name="munching-policy-use-full-token-image" id="munching-policy-use-full-token-image" {{#if useFullTokenImage}}checked{{/if}} data-section="useFullTokenImage"></dnd5e-checkbox>
      </div>
      <p class="hint">Use the full monster illustration for tokens instead of the close-up circular avatar crop.</p>
    </div>
  </fieldset>

</section>
