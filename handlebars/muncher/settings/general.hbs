<section id="ddb-importer-muncher-general" class="tab ddb-muncher {{ tab.cssClass }} {{#if tab.active}} active{{/if}}" data-tab="{{ tab.id }}" data-group="{{ tab.group }}">
  
  <fieldset>
    <legend><i class="fas fa-key"></i> D&D Beyond Authentication & Proxy</legend>
    
    <div class="form-group">
      <label>Cobalt Session Cookie</label>
      <div class="form-fields" style="display: flex; gap: 8px;">
        <input class="setup-config" type="password" id="cobalt-cookie-input" name="cobalt-cookie" value="{{cobalt}}" placeholder="Auto-managed via Jenne Proxy or paste manually" style="flex: 1;" />
        <button type="button" data-action="checkCobaltButton" id="check-cobalt-button" class="munch-button jenne-form-inline-btn" style="height: 30px !important; padding: 0 10px !important; font-family: 'Inter', sans-serif !important; font-size: 12px !important; font-weight: 500 !important; text-transform: none !important; letter-spacing: normal !important; white-space: nowrap;">
          <i class="fas fa-plug" style="font-size: 11px;"></i> Check Connection
        </button>
      </div>
      <p class="hint">Your D&D Beyond session authentication token. If your Jenne Proxy has auto-login configured, this is managed automatically.</p>
    </div>

    <div class="form-group" style="margin-top: 10px;">
      <label>Custom Proxy URL</label>
      <div class="form-fields">
        <input class="setup-config" type="text" id="custom-proxy-url-input" name="api-endpoint" value="{{customProxyUrl}}" placeholder="https://ddb-proxy.clemson.engineer" />
      </div>
      <p class="hint">The base URL of your self-hosted Jenne DDB Proxy (e.g. <code>https://ddb-proxy.clemson.engineer</code>).</p>
    </div>

    <div class="form-group" style="margin-top: 10px;">
      <label>Dynamic Character Sync</label>
      <div class="form-fields">
        <dnd5e-checkbox name="dynamic-sync" id="dynamic-sync-checkbox" {{#if dynamicSync}}checked{{/if}} data-section="dynamicSync"></dnd5e-checkbox>
      </div>
      <p class="hint">Enable real-time two-way synchronization of HP, spell slots, currency, and conditions between Foundry VTT and D&D Beyond character sheets.</p>
    </div>
  </fieldset>

  <fieldset style="margin-top: 14px;">


  <fieldset style="margin-top: 14px;">
    <legend><i class="fas fa-sliders-h"></i> Shared Settings</legend>
    {{#each genericConfig}}
    <div class="form-group munching-generic-config">
      <label>{{ this.label }}</label>
      <div class="form-fields">
        <dnd5e-checkbox name="{{this.name}}" id="munching-generic-policy-{{this.name}}" {{#if this.isChecked}}checked{{/if}}
        data-section="{{this.name}}" {{#if this.enabled}}enabled{{else}}disabled{{/if}}></dnd5e-checkbox>
      </div>
      <p class="hint">{{{this.hint}}}</p>
    </div>
    {{/each}}
  </fieldset>

  <fieldset style="margin-top: 14px;">
    <legend><i class="fas fa-magic"></i> Gameplay Rule Automations</legend>
    <p class="hint">Optional, lightweight automation enhancements for specific class features.</p>
    
    {{#each enhancementConfig}}
    <div class="form-group enhancements-config" style="margin-top: 8px;">
      <label>{{ this.label }}</label>
      <div class="form-fields">
        <dnd5e-checkbox name="{{this.name}}" id="enhancements-config-{{this.name}}" {{#if this.isChecked}}checked{{/if}}
        data-section="{{this.name}}" {{#if this.enabled}}enabled{{else}}disabled{{/if}}></dnd5e-checkbox>
      </div>
      <p class="hint">{{{this.hint}}}</p>
    </div>
    {{/each}}
  </fieldset>

  <fieldset style="margin-top: 14px;">
    <legend><i class="fas fa-dragon"></i> Monster Configuration</legend>
    
    <div class="form-group" style="margin-top: 8px;">
      <label>Hide monster actions in chat?</label>
      <div class="form-fields">
        <dnd5e-checkbox name="munching-policy-hide-description" id="munching-policy-hide-description" {{#if hideMonsterDescription}}checked{{/if}} data-section="hideDescription"></dnd5e-checkbox>
      </div>
      <p class="hint">Hides monster action details and descriptions from players in chat roll cards.</p>
    </div>

    <div class="form-group" style="margin-top: 10px;">
      <label>Retain existing biographies?</label>
      <div class="form-fields">
        <dnd5e-checkbox name="munching-policy-monster-retain-biography" id="munching-policy-monster-retain-biography" {{#if retainMonsterBiography}}checked{{/if}} data-section="retainBiography"></dnd5e-checkbox>
      </div>
      <p class="hint">Preserve custom GM biography edits when updating existing monsters from compendiums.</p>
    </div>

    <div class="form-group" style="margin-top: 10px;">
      <label>Use full portrait art for tokens?</label>
      <div class="form-fields">
        <dnd5e-checkbox name="munching-policy-use-full-token-image" id="munching-policy-use-full-token-image" {{#if useFullTokenImage}}checked{{/if}} data-section="useFullTokenImage"></dnd5e-checkbox>
      </div>
      <p class="hint">Use the full monster illustration for tokens instead of the close-up circular avatar crop.</p>
    </div>
  </fieldset>

</section>

