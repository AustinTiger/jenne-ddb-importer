<section id="ddb-importer-muncher-characters" class="tab ddb-muncher {{ tab.cssClass }} {{#if tab.active}} active{{/if}}" data-tab="{{ tab.id }}" data-group="{{ tab.group }}">

  <!-- D&D Beyond Campaign -->
  <fieldset>
    <legend><i class="fas fa-users"></i> D&D Beyond Campaign</legend>
    <p class="hint">Link your D&D Beyond Campaign to enable campaign content sharing, character imports, and party synchronization.</p>

    <div class="form-group" style="margin-top: 8px;">
      <label>Campaign</label>
      <div class="form-fields" style="display: flex; gap: 8px;">
        <select name="campaign-select" id="settings-campaign-select" class="form-select" style="flex: 1;">
          <option value="">-- Select Linked Campaign --</option>
          {{#each availableCampaigns}}
          <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.name}}{{#if this.dmUsername}} ({{this.dmUsername}}){{/if}} - ID: {{this.id}}</option>
          {{/each}}
        </select>
        <button type="button" id="btn-fetch-campaigns-settings" class="munch-button jenne-form-inline-btn" style="height: 30px !important; padding: 0 10px !important; font-family: 'Inter', sans-serif !important; font-size: 12px !important; font-weight: 500 !important; text-transform: none !important; letter-spacing: normal !important; white-space: nowrap;">
          <i class="fas fa-sync" style="font-size: 11px;"></i> Fetch Campaigns
        </button>
      </div>
    </div>

    <div class="form-group" style="margin-top: 8px;">
      <label>Manual Campaign ID</label>
      <div class="form-fields">
        <input type="text" id="settings-campaign-id-input" name="campaign-id" value="{{campaignId}}" placeholder="e.g. 361284" />
      </div>
      <p class="hint">The numeric ID from your D&D Beyond campaign URL (e.g. <code>https://www.dndbeyond.com/campaigns/361284</code>).</p>
    </div>
  </fieldset>

  <!-- Export to D&D Beyond -->
  <fieldset style="margin-top: 14px;">
    <legend><i class="fas fa-file-export"></i> Export to D&D Beyond</legend>
    <p class="hint">Select the character attributes to synchronize back to D&D Beyond when updating or pushing character changes.</p>

    <div class="form-group stacked checkbox-grid" style="margin-top: 8px;">
      <div class="form-fields" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px;">
        {{#each syncConfig}}
        <label class="checkbox" style="display: flex; align-items: center; gap: 6px; font-size: 12px;">
          <dnd5e-checkbox name="{{this.name}}" id="setting-{{this.name}}" class="ddb-export-policy-checkbox"
            data-section="{{this.name}}" {{#if this.isChecked}}checked{{/if}}
            {{#if this.enabled}}enabled{{else}}disabled{{/if}}></dnd5e-checkbox>
          <span>{{this.label}}</span>
        </label>
        {{/each}}
      </div>
    </div>
  </fieldset>

</section>
