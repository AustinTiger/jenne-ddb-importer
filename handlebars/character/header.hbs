<header class="sheet-header ddbcharacter jenne-character-header">
  <div class="jenne-header-avatar-block">
    <img class="ddbcharacter jenne-avatar-frame" src="{{actor.prototypeToken.texture.src}}" alt="{{actor.name}}" />
  </div>

  <div class="jenne-header-center-block">
    <div class="form-section">
      <div class="form-caption jenne-caption">
        <span><i class="fas fa-link"></i> D&D BEYOND URL</span>
        <span class="dndbeyond-url-status">
          {{#if actor.flags.ddbimporter.dndbeyond.characterId}}
            <i class="fas fa-check-circle" style="color: var(--jenne-success-color, #6dae11);" title="Valid Character ID Connected"></i>
          {{/if}}
        </span>
      </div>
      <div class="form-content" style="display: flex; gap: 6px; margin-top: 4px;">
        <input type="text" name="dndbeyond-url" class="setup-config" style="flex: 1;" placeholder="https://www.dndbeyond.com/characters/..." value="{{#if actor.flags.ddbimporter.dndbeyond.url}}{{actor.flags.ddbimporter.dndbeyond.url}}{{/if}}" />
        <button type="button" id="open-dndbeyond-url" name="open-dndbeyond-url" class="munch-button" style="padding: 0 12px; height: 32px;" title="Open in D&D Beyond" {{#if actor.flags.ddbimporter.dndbeyond.characterId}}enabled{{else}}disabled{{/if}}>
          <i class="fas fa-external-link-alt"></i>
        </button>
      </div>
    </div>
  </div>

  <div class="jenne-header-id-block">
    <div class="form-section">
      <div class="form-caption jenne-caption">
        <span><i class="fas fa-fingerprint"></i> CHARACTER ID</span>
      </div>
      <div class="form-content" style="margin-top: 4px;">
        <span class="dndbeyond-character-id jenne-id-badge">{{#if actor.flags.ddbimporter.dndbeyond.characterId}}{{actor.flags.ddbimporter.dndbeyond.characterId}}{{else}}Not Detected{{/if}}</span>
      </div>
    </div>
  </div>
</header>
