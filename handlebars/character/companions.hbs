<section id="ddb-character-manager-companions" class="tab {{ tab.cssClass }} {{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">

  <fieldset>
    <legend><i class="fas fa-paw"></i> Companions & Extras</legend>
    <p class="hint">Companions, familiars, mounts, summoned creatures, and wild shapes configured under your character's "Extras" tab on D&D Beyond can be imported directly into your world's actor directory.</p>
  </fieldset>

  <div style="margin-top: 14px;">
    <button data-action="importCompanions" type="button" id="dndbeyond-character-extras-start" class="munch-button jenne-btn-hero"
      {{#if actor.flags.ddbimporter.dndbeyond.characterId}}enabled{{else}}disabled{{/if}}>
      <i class="fas fa-paw"></i> {{#if actor.flags.ddbimporter.dndbeyond.characterId}}Import Companions & Extras{{else}}Please Connect & Import Character First{{/if}}
    </button>
  </div>

</section>
