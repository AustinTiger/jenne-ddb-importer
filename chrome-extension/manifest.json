{
  "manifest_version": 3,
  "name": "DDB Importer Cobalt Cookie Helper",
  "version": "1.0.0",
  "description": "Helper to retrieve Cobalt Session cookie for DDB Importer.",
  "permissions": ["cookies"],
  "host_permissions": ["https://*.dndbeyond.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
