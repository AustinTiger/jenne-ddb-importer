{
  "id": "jenne-ddb-importer",
  "title": "Jenne D&D Beyond Importer",
  "description": "Modern, streamlined, 100% self-hosted D&D Beyond importer for Foundry VTT. Connects directly to your local DDB Proxy with zero Patreon gates or external cloud dependencies.",
  "version": "1.0.0",
  "compatibility": {
    "minimum": "13",
    "verified": "14"
  },
  "authors": [
    {
      "name": "Austin Tiger & Jenne"
    }
  ],
  "relationships": {
    "requires": [
      {
        "id": "jenne-suite",
        "type": "module"
      }
    ]
  },
  "esmodules": [
    "scripts/init.mjs"
  ],
  "styles": [
    "styles/jenne-ddb-importer.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ]
}
