{
  "id": "jenne-ddb-importer",
  "title": "Jenne D&D Beyond Importer",
  "license": "MIT License",
  "description": "Full D&D Beyond Integration Suite with Jenne Asset Manager aesthetic and self-hosted proxy support.",
  "version": "0.5.0",
  "url": "https://github.com/AustinTiger/jenne-ddb-importer",
  "compatibility": {
    "minimum": "13",
    "verified": "14",
    "maximum": 14
  },
  "authors": [
    {
      "name": "Austin Tiger & Jenne"
    }
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "relationships": {
    "requires": [
      {
        "id": "jenne-suite",
        "type": "module"
      }
    ]
  },
  "scripts": [
    "./vendor/zipjs/zip-fs.js"
  ],
  "esmodules": [
    "scripts/init.mjs"
  ],
  "styles": [
    "./css/default.css",
    "./css/import.css",
    "./css/journal.css",
    "./css/notifications.css",
    "./css/adventure.css",
    "./css/maps.css",
    "./styles/jenne-ddb-importer.css"
  ],
  "packs": [],
  "socket": true,
  "persistentStorage": true
}
