<div class="jenne-asset-manager jenne-container" style="display: flex; flex-direction: column; height: 100%; width: 100%; overflow: hidden;">
  <!-- Body Container: Sidebar + Content -->
  <div class="jenne-body-container" style="display: flex; flex: 1; overflow: hidden; width: 100%;">
    <!-- Left Sidebar Navigation -->
    <aside class="jenne-sidebar">
    <div class="jenne-sidebar-header">
      <div style="display: flex; align-items: center; gap: 10px;">
        <i class="fas fa-dragon" style="color: #d4a857; font-size: 18px;"></i>
        <h3 style="margin: 0; font-size: 14px;">D&D Beyond Importer</h3>
      </div>
    </div>

    <!-- Navigation Tabs -->
    <div class="jenne-nav-list" style="padding: 12px 8px; display: flex; flex-direction: column; gap: 4px; overflow-y: auto; flex: 1;">
      <button type="button" class="jenne-nav-item active" data-tab="monsters">
        <i class="fas fa-skull"></i> Monsters
      </button>
      <button type="button" class="jenne-nav-item" data-tab="spells">
        <i class="fas fa-magic"></i> Spells
      </button>
      <button type="button" class="jenne-nav-item" data-tab="items">
        <i class="fas fa-shield-alt"></i> Items & Equipment
      </button>
      <button type="button" class="jenne-nav-item" data-tab="character-features">
        <i class="fas fa-id-card"></i> Classes & Features
      </button>
      <button type="button" class="jenne-nav-item" data-tab="adventures">
        <i class="fas fa-book-open"></i> Adventures
      </button>
      <button type="button" class="jenne-nav-item" data-tab="character-import">
        <i class="fas fa-user-plus"></i> Import Character
      </button>
      <button type="button" class="jenne-nav-item" data-tab="settings">
        <i class="fas fa-cog"></i> Settings & Sources
      </button>
    </div>

    <!-- Sidebar Footer / Quick Status -->
    <div class="jenne-sidebar-footer" style="padding: 12px; border-top: 1px solid var(--border-color); font-size: 11px; color: var(--text-muted);">
      <div style="display: flex; justify-content: space-between; align-items: center;">
        <span><i class="fas fa-server"></i> Jenne Proxy</span>
        <span id="sidebar-proxy-badge" style="color: var(--success-color); font-weight: bold;"><i class="fas fa-check-circle"></i> Connected</span>
      </div>
    </div>
  </aside>

  <!-- Right Content Area -->
  <main class="jenne-content-area" style="flex: 1; display: flex; flex-direction: column; background: var(--bg-primary); overflow: hidden;">
    
    <!-- Top Header Banner -->
    <header class="jenne-top-header" style="padding: 14px 20px; border-bottom: 1px solid var(--border-color); background: var(--bg-secondary); display: flex; justify-content: space-between; align-items: center;">
      <div>
        <h2 id="active-tab-title" style="margin: 0; font-size: 17px; color: var(--text-active);">Monsters Muncher</h2>
        <span id="active-tab-subtitle" style="font-size: 11.5px; color: var(--text-muted);">Extract and import creature statblocks, tokens, and avatars from D&D Beyond.</span>
      </div>
      <div style="display: flex; gap: 8px;">
        <button type="button" id="btn-quick-check-auth" class="jenne-btn btn-secondary" style="height: 30px; font-size: 11px; padding: 0 12px;">
          <i class="fas fa-plug"></i> Test Connection
        </button>
      </div>
    </header>

    <!-- Main Scrollable Body -->
    <div class="jenne-main-body" style="flex: 1; padding: 20px; overflow-y: auto;">
      
      <!-- ==================== TAB 1: MONSTERS ==================== -->
      <div class="jenne-tab-panel active" data-tab="monsters">
        <div class="jenne-panel-card">
          <div class="jenne-card-header">
            <h4><i class="fas fa-filter"></i> Monster Filters & Configuration</h4>
          </div>
          <div class="jenne-card-body">
            <div class="jenne-grid-2">
              <div class="jenne-form-field">
                <label>Search Monster Name (optional):</label>
                <input type="text" id="monster-search-input" placeholder="e.g. Goblin, Adult Red Dragon..." class="jenne-input" />
              </div>
              <div class="jenne-form-field">
                <label>Compendium Target:</label>
                <input type="text" value="world.ddb-monsters" disabled class="jenne-input" />
              </div>
            </div>

            <div class="jenne-toggle-grid" style="margin-top: 14px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px;">
              <label class="jenne-checkbox-label">
                <input type="checkbox" id="monster-opt-homebrew" /> Include Homebrew
              </label>
              <label class="jenne-checkbox-label">
                <input type="checkbox" id="monster-opt-legacy" /> Exclude Legacy (2014)
              </label>
              <label class="jenne-checkbox-label">
                <input type="checkbox" id="monster-opt-exact" /> Exact Name Match Only
              </label>
            </div>
          </div>
        </div>

        <div style="margin-top: 16px;">
          <button type="button" id="btn-munch-monsters" class="jenne-btn btn-primary" style="width: 100%; height: 38px; font-size: 13px;">
            <i class="fas fa-dragon"></i> Munch Monsters from D&D Beyond
          </button>
        </div>

        <div id="status-monsters" class="jenne-status-card" style="margin-top: 14px;">Ready to munch monsters.</div>
      </div>

      <!-- ==================== TAB 2: SPELLS ==================== -->
      <div class="jenne-tab-panel" data-tab="spells">
        <div class="jenne-panel-card">
          <div class="jenne-card-header">
            <h4><i class="fas fa-hat-wizard"></i> Spell Class Filters</h4>
          </div>
          <div class="jenne-card-body">
            <div class="jenne-class-buttons" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px;">
              <button type="button" class="jenne-btn btn-toggle active" data-class="Wizard">Wizard</button>
              <button type="button" class="jenne-btn btn-toggle" data-class="Cleric">Cleric</button>
              <button type="button" class="jenne-btn btn-toggle" data-class="Druid">Druid</button>
              <button type="button" class="jenne-btn btn-toggle" data-class="Bard">Bard</button>
              <button type="button" class="jenne-btn btn-toggle" data-class="Sorcerer">Sorcerer</button>
              <button type="button" class="jenne-btn btn-toggle" data-class="Warlock">Warlock</button>
              <button type="button" class="jenne-btn btn-toggle" data-class="Paladin">Paladin</button>
              <button type="button" class="jenne-btn btn-toggle" data-class="Ranger">Ranger</button>
              <button type="button" class="jenne-btn btn-toggle" data-class="Artificer">Artificer</button>
              <button type="button" class="jenne-btn btn-toggle" data-class="all">All Classes</button>
            </div>
          </div>
        </div>

        <div style="margin-top: 16px;">
          <button type="button" id="btn-munch-spells" class="jenne-btn btn-primary" style="width: 100%; height: 38px; font-size: 13px;">
            <i class="fas fa-magic"></i> Munch Selected Spells
          </button>
        </div>

        <div id="status-spells" class="jenne-status-card" style="margin-top: 14px;">Ready to munch spells.</div>
      </div>

      <!-- ==================== TAB 3: ITEMS ==================== -->
      <div class="jenne-tab-panel" data-tab="items">
        <div class="jenne-panel-card">
          <div class="jenne-card-header">
            <h4><i class="fas fa-boxes"></i> Equipment & Magic Items</h4>
          </div>
          <div class="jenne-card-body">
            <p style="font-size: 12px; color: var(--text-muted); margin: 0 0 10px 0;">Imports weapons, armor, adventuring gear, tools, and magic items directly into <strong>DDB Items</strong>.</p>
            <div class="jenne-form-field">
              <label>Campaign ID Filter (optional):</label>
              <input type="text" id="items-campaign-id" placeholder="Leave empty for all available items" class="jenne-input" />
            </div>
          </div>
        </div>

        <div style="margin-top: 16px;">
          <button type="button" id="btn-munch-items" class="jenne-btn btn-primary" style="width: 100%; height: 38px; font-size: 13px;">
            <i class="fas fa-shield-alt"></i> Munch All Equipment & Magic Items
          </button>
        </div>

        <div id="status-items" class="jenne-status-card" style="margin-top: 14px;">Ready to munch items.</div>
      </div>

      <!-- ==================== TAB 4: CHARACTER FEATURES ==================== -->
      <div class="jenne-tab-panel" data-tab="character-features">
        <div class="jenne-panel-card">
          <div class="jenne-card-header">
            <h4><i class="fas fa-id-card"></i> Classes, Species, Feats & Backgrounds</h4>
          </div>
          <div class="jenne-card-body">
            <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px;">
              <button type="button" class="jenne-btn btn-secondary btn-feature-munch" data-feature="classes" style="height: 36px;">
                <i class="fas fa-fist-raised"></i> Munch Classes & Subclasses
              </button>
              <button type="button" class="jenne-btn btn-secondary btn-feature-munch" data-feature="feats" style="height: 36px;">
                <i class="fas fa-medal"></i> Munch Feats
              </button>
              <button type="button" class="jenne-btn btn-secondary btn-feature-munch" data-feature="races" style="height: 36px;">
                <i class="fas fa-dna"></i> Munch Species / Races
              </button>
              <button type="button" class="jenne-btn btn-secondary btn-feature-munch" data-feature="backgrounds" style="height: 36px;">
                <i class="fas fa-scroll"></i> Munch Backgrounds
              </button>
            </div>
          </div>
        </div>

        <div id="status-features" class="jenne-status-card" style="margin-top: 14px;">Ready to munch character features.</div>
      </div>

      <!-- ==================== TAB 5: ADVENTURES ==================== -->
      <div class="jenne-tab-panel" data-tab="adventures">
        <div class="jenne-panel-card">
          <div class="jenne-card-header">
            <h4><i class="fas fa-book-open"></i> Direct D&D Beyond Adventure Importer</h4>
          </div>
          <div class="jenne-card-body">
            <p style="font-size: 12px; color: var(--text-muted); margin: 0 0 12px 0;">
              Extracts complete chapters, formatted text, artwork, and scenes directly from D&D Beyond into <strong>DDB Adventures</strong> and <strong>DDB Journals</strong> compendiums.
            </p>

            <div class="jenne-form-field">
              <label>Select Adventure / Sourcebook:</label>
              <div style="display: flex; gap: 8px;">
                <select id="select-adventure-catalog" class="jenne-select" style="flex: 1;">
                  <option value="">Click "Load Catalog" below...</option>
                </select>
                <button type="button" id="btn-load-adv-catalog" class="jenne-btn btn-secondary" style="height: 34px;">
                  <i class="fas fa-sync-alt"></i> Load Catalog
                </button>
              </div>
            </div>
          </div>
        </div>

        <div style="margin-top: 16px;">
          <button type="button" id="btn-import-adv" class="jenne-btn btn-primary" style="width: 100%; height: 38px; font-size: 13px;">
            <i class="fas fa-download"></i> Extract & Import Selected Adventure
          </button>
        </div>

        <div id="status-adventures" class="jenne-status-card" style="margin-top: 14px;">Ready to import adventures.</div>
      </div>

      <!-- ==================== TAB 6: CHARACTER IMPORT ==================== -->
      <div class="jenne-tab-panel" data-tab="character-import">
        <div class="jenne-panel-card">
          <div class="jenne-card-header">
            <h4><i class="fas fa-user-plus"></i> Import Character from D&D Beyond</h4>
          </div>
          <div class="jenne-card-body">
            <div class="jenne-form-field">
              <label>Character URL or ID:</label>
              <input type="text" id="char-import-url" placeholder="https://www.dndbeyond.com/characters/12345678" class="jenne-input" />
            </div>
          </div>
        </div>

        <div style="margin-top: 16px;">
          <button type="button" id="btn-import-char" class="jenne-btn btn-primary" style="width: 100%; height: 38px; font-size: 13px;">
            <i class="fas fa-file-import"></i> Import / Update Character
          </button>
        </div>

        <div id="status-character" class="jenne-status-card" style="margin-top: 14px;">Ready to import character.</div>
      </div>

      <!-- ==================== TAB 7: SETTINGS ==================== -->
      <div class="jenne-tab-panel" data-tab="settings">
        <div class="jenne-panel-card">
          <div class="jenne-card-header">
            <h4><i class="fas fa-server"></i> Jenne Proxy & Authentication Configuration</h4>
          </div>
          <div class="jenne-card-body">
            <div class="jenne-form-field">
              <label>Proxy URL:</label>
              <input type="text" id="settings-proxy-url" value="{{proxyUrl}}" class="jenne-input" />
            </div>

            <div class="jenne-form-field" style="margin-top: 10px;">
              <label>Cobalt Session Cookie (Optional if Auto-Login is enabled on Proxy):</label>
              <div style="display: flex; gap: 6px; align-items: center;">
                <input type="text" autocomplete="off" spellcheck="false" id="settings-cobalt-cookie" value="{{cobaltCookie}}" placeholder="Auto-managed by Jenne Proxy Auto-Login" class="jenne-input" style="flex: 1;" />
                <button type="button" id="btn-clear-settings-cobalt" class="jenne-btn btn-secondary" title="Clear Cookie" style="height: 34px; padding: 0 10px; display: inline-flex; align-items: center; justify-content: center;">
                  <i class="fas fa-times"></i>
                </button>
              </div>
            </div>

            <div style="display: flex; gap: 8px; margin-top: 14px;">
              <button type="button" id="btn-test-auth" class="jenne-btn btn-secondary" style="height: 34px;">
                <i class="fas fa-plug"></i> Test Connection
              </button>
              <button type="button" id="btn-save-cfg" class="jenne-btn btn-primary" style="height: 34px;">
                <i class="fas fa-save"></i> Save Settings
              </button>
            </div>
          </div>
        </div>

        <div id="status-settings" class="jenne-status-card" style="margin-top: 14px;">Proxy configured.</div>
      </div>

    </div>
  </main>
  </div>

  <!-- Standardized Jenne Suite Footer Bar (Full Width) -->
  <footer class="jenne-footer-bar">
    <div class="footer-left-status">
      <div class="footer-status-pill status-good" title="Jenne Proxy Status">
        <i class="fas fa-server"></i>
        <span>Proxy: <strong>Connected</strong></span>
        <i class="fas fa-circle status-dot dot-good"></i>
      </div>
    </div>

    <div class="footer-center-status">
      <div class="footer-status-pill status-stats">
        <i class="fas fa-dragon"></i>
        <span>D&D Beyond Integration</span>
      </div>
    </div>

    <div class="footer-right-status">
      <span class="footer-version-tag">
        D&D Beyond Importer v{{moduleVersion}}
      </span>
      <button type="button" class="jenne-btn-icon" data-action="openSettings" title="Module Settings">
        <i class="fas fa-cog"></i>
      </button>
    </div>
  </footer>
</div>
